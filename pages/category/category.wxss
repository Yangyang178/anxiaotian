page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-content {
  padding: 16rpx 32rpx 32rpx;
}

.tab-header {
  display: flex;
  flex-direction: row;
  background-color: #F5F5F5;
  border-radius: 40rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 36rpx;
}

.tab-btn.tab-active {
  background-color: #FFFFFF;
  color: #333333;
  font-weight: 600;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #E8E8E8;
}

.filter-item.filter-active {
  background-color: #F6FFED;
  color: #52C41A;
  border-color: #52C41A;
}

.safety-filters {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.safety-filter {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
}

.safety-filter.safety-filter-active {
  font-weight: 600;
}

.result-list {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  border-left: 6rpx solid #52C41A;
}

.list-item.safety-warning {
  border-left-color: #FAAD14;
}

.list-item.safety-danger {
  border-left-color: #FF4D4F;
}

.list-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.safety-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.safety-dot-safe { background-color: #52C41A; }
.safety-dot-warning { background-color: #FAAD14; }
.safety-dot-danger { background-color: #FF4D4F; }

.item-info {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.item-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-right: 12rpx;
}

.item-code {
  font-size: 24rpx;
  color: #999999;
}

.item-right {
  flex-shrink: 0;
}

.item-safety {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.safety-text-safe { color: #52C41A; background-color: #F6FFED; }
.safety-text-warning { color: #D48806; background-color: #FFFBE6; }
.safety-text-danger { color: #FF4D4F; background-color: #FFF2F0; }

.empty-state {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}