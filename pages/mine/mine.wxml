<navigation-bar title="我的" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-content">
    <view class="profile-header">
      <view class="profile-avatar">
        <view class="avatar-inner"></view>
      </view>
      <view class="profile-info">
        <text class="profile-title">食安查</text>
        <text class="profile-subtitle">看懂配料表再下单</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-number">{{favoriteCount}}</text>
        <text class="stats-label">收藏</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{historyCount}}</text>
        <text class="stats-label">扫描</text>
      </view>
    </view>

    <view class="safety-index-card">
      <text class="safety-index-title">食品安全指数</text>
      <block wx:if="{{safetyIndex.score >= 0}}">
        <view class="safety-index-circle" style="background: conic-gradient({{safetyIndexColor}} 0% {{safetyIndex.score}}%, #F0F0F0 {{safetyIndex.score}}% 100%)">
          <view class="safety-index-circle-inner">
            <text class="safety-index-score">{{safetyIndex.score}}</text>
          </view>
        </view>
        <text class="safety-index-level" style="color: {{safetyIndexColor}}">{{safetyIndex.level}}</text>
        <text class="safety-index-desc">{{safetyIndex.desc}}</text>
      </block>
      <block wx:else>
        <text class="safety-index-empty">开始扫描配料表获取您的安全指数</text>
      </block>
    </view>

    <view class="tab-header">
      <view class="tab-btn {{activeTab === 'favorites' ? 'tab-active' : ''}}" data-tab="favorites" bindtap="switchTab">
        <text>我的收藏</text>
      </view>
      <view class="tab-btn {{activeTab === 'history' ? 'tab-active' : ''}}" data-tab="history" bindtap="switchTab">
        <text>扫描历史</text>
      </view>
    </view>

    <view wx:if="{{activeTab === 'favorites'}}" class="list-section">
      <view wx:if="{{favorites.length === 0}}" class="empty-state">
        <text class="empty-text">还没有收藏任何添加剂</text>
        <text class="empty-hint">在详情页点击收藏即可添加</text>
      </view>
      <block wx:else>
        <view
          wx:for="{{displayFavorites}}"
          wx:key="id"
          class="fav-item safety-{{item.safetyClass}}"
          data-id="{{item.id}}"
          bindtap="onTapAdditive"
        >
          <view class="fav-left">
            <view class="safety-dot safety-dot-{{item.safetyClass}}"></view>
            <view class="fav-info">
              <text class="fav-name">{{item.name}}</text>
              <text class="fav-summary">{{item.summary}}</text>
            </view>
          </view>
          <view class="fav-remove" data-id="{{item.id}}" catchtap="onRemoveFavorite">
            <text class="remove-text">移除</text>
          </view>
        </view>
        <view wx:if="{{favoriteCount > 3}}" class="view-all-btn" bindtap="onToggleFavorites">
          <text class="view-all-text">{{showAllFavorites ? '收起' : '查看全部(' + favoriteCount + ')'}}</text>
          <view class="view-all-arrow {{showAllFavorites ? 'arrow-up' : ''}}"></view>
        </view>
      </block>
    </view>

    <view wx:if="{{activeTab === 'history'}}" class="list-section">
      <view wx:if="{{history.length === 0}}" class="empty-state">
        <text class="empty-text">还没有扫描记录</text>
        <text class="empty-hint">去扫一扫页面解析配料表</text>
      </view>
      <block wx:else>
        <view wx:for="{{displayHistory}}" wx:key="time" class="history-item" data-index="{{index}}" bindtap="onViewHistory">
          <view class="history-header">
            <text class="history-time">{{item.timeText}}</text>
            <view class="history-stats">
              <text class="history-stat safe" wx:if="{{item.result.safe}}">🟢{{item.result.safe}}</text>
              <text class="history-stat warning" wx:if="{{item.result.warning}}">🟡{{item.result.warning}}</text>
              <text class="history-stat danger" wx:if="{{item.result.danger}}">🔴{{item.result.danger}}</text>
            </view>
          </view>
          <text class="history-text">{{item.text}}</text>
        </view>
        <view wx:if="{{historyCount > 3}}" class="view-all-btn" bindtap="onToggleHistory">
          <text class="view-all-text">{{showAllHistory ? '收起' : '查看全部(' + historyCount + ')'}}</text>
          <view class="view-all-arrow {{showAllHistory ? 'arrow-up' : ''}}"></view>
        </view>
        <view class="clear-btn" bindtap="onClearHistory">
          <text>清空历史</text>
        </view>
      </block>
    </view>

    <view class="about-section">
      <view class="about-card">
        <text class="about-title">关于食安查</text>
        <text class="about-text">食安查是一款食品添加剂查询工具，致力于帮助消费者快速了解食品添加剂的安全信息。</text>
        <text class="about-text">所有数据来源于GB2760-2024、JECFA评估报告、FDA及EFSA等权威机构公开资料。</text>
      </view>
      <view class="disclaimer-card">
        <text class="disclaimer-title">免责声明</text>
        <text class="disclaimer-content">本应用提供的查询结果仅供信息参考，不构成安全评估或消费建议。食品添加剂的安全性取决于使用剂量和个体差异，如有健康疑虑请咨询专业医生。</text>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{showHistoryDetail}}" class="history-detail-overlay" bindtap="onCloseHistoryDetail">
  <view class="history-detail-panel" catchtap="">
    <view class="history-detail-header">
      <text class="history-detail-title">扫描详情</text>
      <view class="history-detail-close" bindtap="onCloseHistoryDetail">
        <text>✕</text>
      </view>
    </view>
    <scroll-view class="history-detail-scroll" scroll-y>
      <view wx:if="{{historyDetail.result}}" class="history-detail-content">
        <view class="history-detail-stats">
          <view class="hd-stat-item">
            <text class="hd-stat-number">{{historyDetail.result.total}}</text>
            <text class="hd-stat-label">添加剂</text>
          </view>
          <view class="hd-stat-item hd-stat-safe">
            <text class="hd-stat-number">{{historyDetail.result.safe}}</text>
            <text class="hd-stat-label">🟢 安全</text>
          </view>
          <view class="hd-stat-item hd-stat-warning">
            <text class="hd-stat-number">{{historyDetail.result.warning}}</text>
            <text class="hd-stat-label">🟡 争议</text>
          </view>
          <view class="hd-stat-item hd-stat-danger">
            <text class="hd-stat-number">{{historyDetail.result.danger}}</text>
            <text class="hd-stat-label">🔴 慎用</text>
          </view>
        </view>
        <view class="hd-verdict" wx:if="{{historyDetail.result.danger > 0}}">
          <text class="hd-verdict-danger">⚠️ 含有{{historyDetail.result.danger}}种慎用添加剂，建议谨慎选择</text>
        </view>
        <view class="hd-verdict" wx:elif="{{historyDetail.result.warning > 0}}">
          <text class="hd-verdict-warning">⚠️ 含有{{historyDetail.result.warning}}种争议添加剂，建议适量食用</text>
        </view>
        <view class="hd-verdict" wx:else>
          <text class="hd-verdict-safe">✅ 所含添加剂均在安全范围内</text>
        </view>
        <view wx:if="{{historyDetail.result.items && historyDetail.result.items.length > 0}}" class="history-detail-list">
          <view
            wx:for="{{historyDetail.result.items}}"
            wx:key="id"
            class="history-detail-item safety-{{item.safetyClass}}"
            data-id="{{item.id}}"
            bindtap="onHistoryAdditiveTap"
          >
            <view class="hd-item-left">
              <view class="hd-safety-badge hd-safety-badge-{{item.safetyClass}}">
                <text>{{item.safetyLevel}}</text>
              </view>
              <view class="hd-item-info">
                <text class="hd-item-name">{{item.name}}</text>
                <text class="hd-item-summary">{{item.summary}}</text>
              </view>
            </view>
            <view class="hd-item-arrow"></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<my-tab-bar current="{{3}}"></my-tab-bar>
