page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-content {
  padding: 24rpx 32rpx 32rpx;
}

.profile-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #F6FFED;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-inner {
  width: 48rpx;
  height: 48rpx;
  background-color: #52C41A;
  border-radius: 50%;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.profile-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.stats-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-header {
  display: flex;
  flex-direction: row;
  background-color: #F5F5F5;
  border-radius: 40rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 36rpx;
}

.tab-btn.tab-active {
  background-color: #FFFFFF;
  color: #333333;
  font-weight: 600;
}

.list-section {
  margin-bottom: 24rpx;
}

.empty-state {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 60rpx 32rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  display: block;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCCCCC;
  display: block;
  margin-top: 8rpx;
}

.fav-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid #52C41A;
}

.fav-item.safety-warning { border-left-color: #FAAD14; }
.fav-item.safety-danger { border-left-color: #FF4D4F; }

.fav-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.safety-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.safety-dot-safe { background-color: #52C41A; }
.safety-dot-warning { background-color: #FAAD14; }
.safety-dot-danger { background-color: #FF4D4F; }

.fav-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.fav-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.fav-summary {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-remove {
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.remove-text {
  font-size: 24rpx;
  color: #FF4D4F;
}

.history-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 12rpx;
}

.history-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
}

.history-stats {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.history-stat {
  font-size: 22rpx;
}

.history-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.clear-btn {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #FF4D4F;
}

.about-section {
  margin-top: 16rpx;
}

.about-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.about-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.about-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
  display: block;
}

.disclaimer-card {
  background-color: #FFFBE6;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D48806;
  display: block;
  margin-bottom: 12rpx;
}

.disclaimer-content {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
}