page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-content {
  padding: 24rpx 32rpx 32rpx;
}

.safety-banner {
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.banner-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.banner-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.banner-level {
  font-size: 32rpx;
  font-weight: 700;
}

.banner-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.banner-aliases {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.alias-tag {
  font-size: 22rpx;
  color: #666666;
  background-color: rgba(255, 255, 255, 0.7);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.banner-summary {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  flex: 1;
  margin-left: 32rpx;
}

.status-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.status-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.status-country {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.status-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.detail-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

.warning-card {
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.warning-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.warning-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF4D4F;
}

.warning-text {
  font-size: 28rpx;
  color: #FF4D4F;
  line-height: 1.8;
}

.source-card {
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.source-text {
  font-size: 22rpx;
  color: #BBBBBB;
}

.action-bar {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.fav-btn {
  background-color: #F5F5F5;
  color: #666666;
}

.fav-btn.fav-active {
  background-color: #F6FFED;
  color: #52C41A;
}

.share-btn {
  background-color: #52C41A;
  color: #FFFFFF;
  border: none;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
}

.share-btn::after {
  border: none;
}

.disclaimer {
  text-align: center;
  padding: 16rpx 0 32rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #BBBBBB;
}